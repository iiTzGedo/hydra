# Hydra MCP Service Configuration
# Copy this file to .env and modify as needed

# ===========================================
# API Connection
# ===========================================
# Hydra API base URL
HYDRA_MCP_API_URL=http://localhost:8080/api/v1

# API key for authentication (optional, can use JWT instead)
HYDRA_MCP_API_KEY=

# API request timeout in seconds
HYDRA_MCP_API_TIMEOUT=30

# Shared secret for internal Hydra API -> MCP requests.
# Required for http, sse, and streamable-http transports.
HYDRA_MCP_INTERNAL_SECRET=replace-with-a-random-string-at-least-32-characters

# ===========================================
# Transport Settings
# ===========================================
# Transport mode: 'stdio' (default) or 'http'
# - stdio: For Claude Desktop and MCP-compatible clients
# - http: For web clients and direct HTTP access
HYDRA_MCP_TRANSPORT=stdio

# HTTP server host (only used when transport=http)
HYDRA_MCP_HTTP_HOST=0.0.0.0

# HTTP server port (only used when transport=http)
HYDRA_MCP_HTTP_PORT=8081

# CORS allowed origins for HTTP transport (JSON array)
HYDRA_MCP_CORS_ORIGINS=["*"]

# ===========================================
# Server Settings
# ===========================================
# MCP server name
HYDRA_MCP_SERVER_NAME=hydra-mcp

# MCP server version
HYDRA_MCP_SERVER_VERSION=0.1.0

# ===========================================
# TOON Formatting
# ===========================================
# TOON provides 30-60% token reduction for LLM responses

# Indentation spaces for TOON output
HYDRA_MCP_TOON_INDENT=2

# Field delimiter for TOON arrays: ',' | '\t' | '|'
HYDRA_MCP_TOON_DELIMITER=,

# Array length marker prefix: '' (none) or '#'
HYDRA_MCP_TOON_LENGTH_MARKER=

# ===========================================
# Logging
# ===========================================
# Logging level: DEBUG, INFO, WARNING, ERROR
HYDRA_MCP_LOG_LEVEL=INFO

# Log format: json or text
HYDRA_MCP_LOG_FORMAT=json
