# Hydra MCP Service Configuration
# Copy this file to .env and modify as needed

# ===========================================
# API Connection
# ===========================================
# Hydra API base URL
HYDRA_MCP_API_URL=http://localhost:8080/api/v1

# API key for Hydra API authentication.
# For network transports, this also acts as the default server-side auth
# identity when requests do not forward Authorization or X-API-Key headers.
HYDRA_MCP_API_KEY=

# API request timeout in seconds
HYDRA_MCP_API_TIMEOUT=30

# Optional shared secret for trusted Hydra API/Web -> MCP internal requests.
# Set the same 32+ character value in both services when using forwarded
# X-Hydra-Internal-* headers.
HYDRA_MCP_INTERNAL_SECRET=replace-with-a-random-string-at-least-32-characters

# ===========================================
# Transport Settings
# ===========================================
# Transport mode: 'stdio' (default), 'http', 'sse', or 'streamable-http'
# - stdio: Local subprocess mode for Claude Desktop and MCP-compatible clients
# - streamable-http: Recommended remote MCP transport
# - sse: Legacy remote MCP transport
# - http: Hydra Web/API integration endpoints
HYDRA_MCP_TRANSPORT=stdio

# Host for HTTP-based transports (http, sse, streamable-http)
HYDRA_MCP_HTTP_HOST=127.0.0.1

# Port for HTTP-based transports (http, sse, streamable-http)
HYDRA_MCP_HTTP_PORT=8081

# CORS allowed origins for HTTP-based transports (JSON array)
HYDRA_MCP_CORS_ORIGINS=["*"]

# ===========================================
# Server Settings
# ===========================================
# MCP server name
HYDRA_MCP_SERVER_NAME=hydra-mcp

# MCP server version
HYDRA_MCP_SERVER_VERSION=0.1.0

# ===========================================
# TOON Formatting
# ===========================================
# TOON provides 30-60% token reduction for LLM responses

# Indentation spaces for TOON output
HYDRA_MCP_TOON_INDENT=2

# Field delimiter for TOON arrays: ',' | '\t' | '|'
HYDRA_MCP_TOON_DELIMITER=,

# Array length marker prefix: '' (none) or '#'
HYDRA_MCP_TOON_LENGTH_MARKER=

# ===========================================
# Logging
# ===========================================
# Logging level: DEBUG, INFO, WARNING, ERROR
HYDRA_MCP_LOG_LEVEL=INFO

# Log format: json or text
HYDRA_MCP_LOG_FORMAT=json
