# Hydra Environment Configuration
# Copy this file to .env and adjust values for your environment

# Environment (development, staging, production)
HYDRA_ENV=development

# Debug mode
HYDRA_DEBUG=true

# MongoDB Configuration
HYDRA_MONGODB_URI=mongodb://mongo-dev.db.nimi.labs:27017
HYDRA_MONGODB_DATABASE=hydra

# Redis Configuration
HYDRA_REDIS_URL=redis://redis-dev.db.nimi.labs:6379/0

# JWT Configuration
HYDRA_JWT_SECRET=change-this-to-a-secure-random-string
HYDRA_JWT_ALGORITHM=HS256
HYDRA_JWT_EXPIRE_MINUTES=60
HYDRA_JWT_REFRESH_EXPIRE_DAYS=7

# API Configuration
HYDRA_API_HOST=0.0.0.0
HYDRA_API_PORT=8080
HYDRA_API_WORKERS=4

# Registration Token Settings
HYDRA_REGISTRATION_TOKEN_EXPIRE_DAYS=7
HYDRA_REGISTRATION_TOKEN_MAX_USES=10

# Logging
HYDRA_LOG_LEVEL=INFO
HYDRA_LOG_FORMAT=json

# CORS (comma-separated origins)
HYDRA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
HYDRA_RATE_LIMIT_ENABLED=true
HYDRA_RATE_LIMIT_REQUESTS=100
HYDRA_RATE_LIMIT_WINDOW_SECONDS=60

# Object Storage (S3/Garage) for Agent Binary Distribution
# Required for agent binary distribution - S3 is the single source of truth
HYDRA_OBJECT_STORAGE_ENABLED=true
HYDRA_OBJECT_STORAGE_ENDPOINT=http://garage.local:3900
HYDRA_OBJECT_STORAGE_BUCKET=hydra-bucket
HYDRA_OBJECT_STORAGE_ACCESS_KEY=
HYDRA_OBJECT_STORAGE_SECRET_KEY=
HYDRA_OBJECT_STORAGE_REGION=garage

# SMTP Configuration for Email (password reset, notifications)
HYDRA_SMTP_ENABLED=false
HYDRA_SMTP_HOST=smtp.example.com
HYDRA_SMTP_PORT=587
HYDRA_SMTP_USERNAME=
HYDRA_SMTP_PASSWORD=
HYDRA_SMTP_FROM_ADDRESS=noreply@hydra.local
HYDRA_SMTP_FROM_NAME=Hydra
HYDRA_SMTP_USE_TLS=true
HYDRA_SMTP_STARTTLS=true
HYDRA_SMTP_TIMEOUT=30

# Password Reset Settings
HYDRA_PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
HYDRA_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
