# Docker Compose environment variables for hydra development.
# Copy this file to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker
#
# docker-compose.dev.yml reads from .env.docker via the env_file directive.
# .env.docker is gitignored and must never be committed.

# --- Database credentials ---
HYDRA_MONGODB_URI=mongodb://hydra_app:CHANGEME@mongo-dev.db.nimi.labs:27017?authSource=hydra
HYDRA_REDIS_URL=redis://default:CHANGEME@redis-dev.db.nimi.labs:6379/0

# --- JWT secret (minimum 32 characters in non-development environments) ---
HYDRA_JWT_SECRET=CHANGEME_MIN_32_CHARS_RANDOM_STRING

# --- Object storage (S3/Garage) ---
HYDRA_OBJECT_STORAGE_ENABLED=true
HYDRA_OBJECT_STORAGE_ENDPOINT=http://obs-dev.db.nimi.labs:3900
HYDRA_OBJECT_STORAGE_BUCKET=hydra-bucket
HYDRA_OBJECT_STORAGE_ACCESS_KEY=CHANGEME
HYDRA_OBJECT_STORAGE_SECRET_KEY=CHANGEME
HYDRA_OBJECT_STORAGE_REGION=garage

# --- SMTP (optional) ---
HYDRA_SMTP_ENABLED=false
# HYDRA_SMTP_HOST=
# HYDRA_SMTP_PORT=587

# --- Test script credentials (used by scripts/api_test.py) ---
HYDRA_TEST_USER=system_admin
HYDRA_TEST_PASSWORD=system12345
