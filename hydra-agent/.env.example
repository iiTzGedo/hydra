# Hydra Agent Environment Configuration
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# The deploy/install scripts auto-source .env (values already set in the
# environment always win). The agent binary itself reads its config from
# agent.toml + the credential vault; the runtime vars below are for local
# development/testing only. .env is git-ignored — never commit real secrets.

# ===========================================
# Build & Deploy  (scripts/deploy-agent.sh)
# ===========================================
# S3/Garage object storage for agent binary + bundle distribution.
# Same instance the API addresses via its HYDRA_OBJECT_STORAGE_* settings.
HYDRA_OBJECT_STORAGE_ENDPOINT=http://garage.local:3900
HYDRA_OBJECT_STORAGE_BUCKET=hydra-bucket
HYDRA_OBJECT_STORAGE_ACCESS_KEY=
HYDRA_OBJECT_STORAGE_SECRET_KEY=
HYDRA_OBJECT_STORAGE_REGION=garage

# Build only, skip upload (true/false)
SKIP_UPLOAD=false
# Comma-separated build targets (default: all). e.g. linux-amd64,linux-arm64
TARGETS=
# Number of old versions to retain in object storage
MAX_VERSIONS=15

# ===========================================
# Installation  (scripts/install.sh)
# ===========================================
# Override the API URL written into the generated agent config.
HYDRA_API_URL=http://localhost:8080/api/v1

# ===========================================
# Agent Runtime  (binary — local dev reference only; not auto-loaded)
# ===========================================
# Override the config file path (default: /etc/hydra/agent.toml).
HYDRA_CONFIG=
# Credential cache — normally managed by `hydra login` / `hydra register`
# into the vault dir (/var/cv/hydra). Set here only for local testing.
HYDRA_API_KEY=
HYDRA_AGENT_USER=
HYDRA_AGENT_PWD=
# Log verbosity (e.g. debug, info, hydra_agent=debug)
RUST_LOG=info
