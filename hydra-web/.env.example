# Hydra Web Configuration

# API URL - The base URL for the Hydra API
VITE_API_URL=http://localhost:8080/api/v1

# MCP Server URL (HTTP endpoint for health checks and tool calls)
VITE_MCP_URL=http://localhost:8081

# MCP WebSocket URL (for future real-time chat streaming)
VITE_MCP_WS_URL=ws://localhost:8081/ws

# Application Settings
VITE_APP_NAME=Hydra
VITE_APP_VERSION=0.1.0
