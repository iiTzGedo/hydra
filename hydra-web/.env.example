# Hydra Web Configuration

# API URL - Leave empty to use relative /api/v1 (recommended).
# The serving layer (Vite dev proxy or reverse proxy) routes to the actual API.
# Only set this if you need the browser to call a specific absolute URL directly.
VITE_API_URL=

# Application Settings
VITE_APP_NAME=Hydra
VITE_APP_VERSION=0.1.0
