# Hydra Web Configuration
#
# Client-side variables (NEXT_PUBLIC_*) are embedded in the browser bundle.
# Server-side variables are only available in server components and middleware.
#
# Copy this to .env.local and fill in values for your environment.

# ── Client-side ──────────────────────────────────────────────────
# API URL exposed to the browser.
# Leave empty to use relative /api/v1 (recommended — works with reverse proxy).
# Set to an absolute URL only when the API is on a different origin.
NEXT_PUBLIC_API_URL=

# ── Server-side (SSR) ───────────────────────────────────────────
# Internal API URL for React Server Components.
# Must be an absolute URL reachable from the Next.js server process.
# Examples:
#   Docker Compose: http://hydra-api:8080/api/v1
#   Same host:      http://localhost:8080/api/v1
#   Remote:         http://api.internal:8080/api/v1
# HYDRA_API_URL=

# Rewrite proxy target for development only.
# When set, Next.js rewrites /api/* to this target (replaces Vite's dev proxy).
# Not needed in production — use a reverse proxy instead.
# HYDRA_API_PROXY_TARGET=http://localhost:8080
